<?xml version="1.0" encoding="utf-8"?>
<!--
     Backup rules for Android 12+ (android:dataExtractionRules) on the watch.

     Backups are disabled outright (android:allowBackup="false"): the watch app holds the
     phone-relayed sign-in token (from Iteration 9b) and, from 9c on, raw health measurements —
     none of which may land in a cloud backup or a device-to-device transfer. Excluding every
     domain makes that intent explicit instead of resting on the single allowBackup switch.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
