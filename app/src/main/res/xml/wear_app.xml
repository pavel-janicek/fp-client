<?xml version="1.0" encoding="utf-8"?>
<!--
  Iteration 9a — pairing metadata for the Wear OS companion module (:wear).

  Historically this file was generated by the Android Gradle plugin when the phone APK embedded
  the watch APK via the `wearApp` dependency configuration: the plugin wrote the <wearableApp>
  descriptor (under the name android_wear_micro_apk) and injected the manifest meta-data below.
  AGP 9 removed embedded-Wear support completely, so both halves are kept by hand now. The
  descriptor names the watch application id that belongs with this phone app; the watch APK
  itself is NOT embedded — Wear OS 3+ installs the watch app standalone (see the
  com.google.android.wearable.standalone flag in :wear's manifest). Full decision record:
  docs/WEAR.md.
-->
<wearableApp package="com.fpclient.android" />
