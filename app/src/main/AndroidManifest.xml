<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- On-device track recording (Iteration 8a groundwork). COARSE is requested alongside
         FINE so the system dialog offers the "approximate only" path; recording only starts
         after FINE is granted. FOREGROUND_SERVICE_LOCATION (API 34+) is required to promote
         a service with foregroundServiceType="location". POST_NOTIFICATIONS (API 33+) is
         needed for the ongoing recording notification to be visible, and since Iteration 8f
         also gates the background notification poll — requested only from Settings → Push,
         never at app start. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background notification delivery (Iteration 8f) adds androidx.work; its runtime library
         declares WAKE_LOCK (WorkManager's own wakelocks) and ACCESS_NETWORK_STATE (the
         NetworkType.CONNECTED constraint the poll uses). They are stated here explicitly so the
         app's permission set stays readable without opening a merged manifest. Both are
         normal-protection permissions and nothing extra is requested by this feature. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FitPubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FPClient">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share sheet / "Open with" for GPS track files (GPX, FIT). FIT has no
                 registered MIME type (providers report it as octet-stream) and GPX is
                 frequently reported as generic XML, so the generic types are matched too. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
        </activity>
        <service
            android:name=".recording.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>